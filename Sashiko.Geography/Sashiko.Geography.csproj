<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sashiko.Geography</PackageId>
    <Version>0.1.0</Version>
    <Description>Small, curated world-region, country, region and city registry with trusted embedded loading.</Description>
    <PackageTags>$(SashikoSharedPackageTags);geography;countries;regions;cities;registry</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sashiko.Registries" Version="0.1.2" />
    <EmbeddedResource Include="Data/**/*.json" LogicalName="%(Identity)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="ARCHITECTURE.md" Pack="true" PackagePath="/" />
    <None Include="Data/CONTRIBUTING.md" Pack="true" PackagePath="Data/" />
    <None Include="Data/SOURCES.md" Pack="true" PackagePath="Data/" />
    <InternalsVisibleTo Include="Sashiko.Geography.Tests" />
    <InternalsVisibleTo Include="Sashiko.Maintenance" />
  </ItemGroup>
</Project>
